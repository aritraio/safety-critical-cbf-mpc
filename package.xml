<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>av_cbf_safety_filter</name>
  <version>0.2.0</version>
  <description>Safety-critical autonomous vehicle control: LQR/MPC tracking
    with Control Barrier Function QP safety filtering, adaptive friction
    estimation, and RViz visualization.</description>

  <maintainer email="av-safety@example.com">AV Safety Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Vendored via CMake FetchContent when not installed system-wide -->
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
